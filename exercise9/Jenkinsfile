
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Installing dependencies...'
                sh '''
                    python3 -m venv .venv
                    .venv/bin/pip install --upgrade pip
                    .venv/bin/pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '.venv/bin/python -m unittest discover -s . -p "test_*.py"'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application to a mock directory...'
                sh '''
                    mkdir -p "${WORKSPACE}/python-app-deploy"
                    cp app.py requirements.txt "${WORKSPACE}/python-app-deploy/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting application...'
                sh '''
                    nohup .venv/bin/python \
                        "${WORKSPACE}/python-app-deploy/app.py" \
                        > "${WORKSPACE}/python-app-deploy/app.log" 2>&1 &
                    echo $! > "${WORKSPACE}/python-app-deploy/app.pid"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing application...'
                sh '''
                    .venv/bin/python - <<'PY'
import time
import urllib.request

url = "http://127.0.0.1:5000/"

for attempt in range(20):
    try:
        with urllib.request.urlopen(url, timeout=2) as response:
            body = response.read().decode()
            assert response.status == 200
            assert body == "Hello, Jenkins Multi-Stage Pipeline!"
            print(body)
            break
    except Exception:
        if attempt == 19:
            raise
        time.sleep(1)
PY
                '''
            }
        }
    }

    post {
        always {
            sh '''
                if [ -f "${WORKSPACE}/python-app-deploy/app.pid" ]; then
                    kill "$(cat "${WORKSPACE}/python-app-deploy/app.pid")" 2>/dev/null || true
                fi
            '''
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
